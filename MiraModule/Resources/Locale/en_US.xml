    <!-- Sentinel - Neutral Killing -->
    <string name="ExampleRoleSentinel">Sentinel</string>
    <string name="ExampleRoleSentinelIntroBlurb">Eliminate those who stand in your path.</string>
    <string name="ExampleRoleSentinelTabDescription">Kill players by using your dope abilities!\%nl\%Preferably, explode \%b\%only\%/b\% in a secluded area.</string>
    
    <!-- Sentinel Wiki -->
    <string name="ExampleRoleSentinelWikiDescription">The Sentinel is a Neutral Killing role that can explode themselves to kill anyone nearby. They may also kill normally, but where's the fun in that?</string>
    <string name="ExampleRoleSentinelExplode">Explode</string>
    <string name="ExampleRoleSentinelExplodeWikiDescription">Explode all players nearby.</string>
    
    <!-- Pelican - Neutral Killing -->
    <string name="ExampleRolePelican">Pelican</string>
    <string name="ExampleRolePelicanIntroBlurb">Gulp down every last one of them.</string>
    <string name="ExampleRolePelicanTabDescription">Use your Gulp ability to swallow players whole!\%nl\%Swallowed players vanish with \%b\%no body\%/b\% left behind. They die for good when a meeting is called.</string>

    <!-- Pelican Wiki -->
    <string name="ExampleRolePelicanWikiDescription">The Pelican is a Neutral Killing role that swallows other players, hiding them from the game entirely. Swallowed players leave no corpse and do not appear in the meeting dead list — until the next meeting is called, at which point they die for good. If the Pelican dies, any swallowed players are released alive.</string>
    <string name="ExampleRolePelicanGulp">Gulp</string>
    <string name="ExampleRolePelicanGulpWikiDescription">Swallow a nearby player. They vanish from the map and are hidden until the next meeting.</string>

